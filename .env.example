# Database
TIMESCALE_USER=cryptoradar
TIMESCALE_PASSWORD=cryptoradar_ts_pass
TIMESCALE_DB=marketdata

POSTGRES_USER=cryptoradar
POSTGRES_PASSWORD=cryptoradar_pg_pass
POSTGRES_DB=cryptonews

# Redis (internal container port — unchanged, services talk over docker network)
REDIS_HOST=redis
REDIS_PORT=6379

# Service Ports (HOST-EXPOSED) — 31xxx namespace
# Rule: ~/.claude/rules/local-port-ranges.md (avoid 80xx/8xxx/9xxx, use 30000-49999)
# Internal container ports stay on conventional values (8080-8086 for services,
# 5432 for postgres, 6379 for redis, 80 for nginx) — only the host side changes.
MARKET_DATA_PORT=31081
NEWS_SERVICE_PORT=31082
ANALYTICS_SERVICE_PORT=31083
WHALE_SERVICE_PORT=31084
DERIVATIVES_SERVICE_PORT=31085
SIGNAL_SERVICE_PORT=31086
GATEWAY_PORT=31080
FRONTEND_PORT=31000
TIMESCALE_HOST_PORT=31432
POSTGRES_HOST_PORT=31433
REDIS_HOST_PORT=31379

# Whale Alert API (optional — get free key at https://developer.whale-alert.io)
WHALE_ALERT_API_KEY=

# Gemini AI analysis (optional)
GEMINI_API_KEY=
